# API keys
MISTRAL_API_KEY=your-mistral-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Dynamic expansion parameters
SIMILARITY_THRESHOLD=0.85
MAX_EXPAND=7

# Embedding configuration
# Provider: mock, huggingface, mistral, openai, ollama, or custom
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional for API/custom-compatible providers
EMBEDDING_API_KEY_ENV=
EMBEDDING_BASE_URL=

# LLM/QA generation provider: mistral, openai, openrouter, ollama, or custom
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
LLM_API_KEY_ENV=
LLM_BASE_URL=

# OpenRouter metadata (optional)
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=rag-dynamic-semantic-window

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Benchmark settings
TOP_K=5
NUM_QUESTIONS=3
QA_GENERATION_DELAY=1.1
WIKIPEDIA_MIN_LENGTH=6000
